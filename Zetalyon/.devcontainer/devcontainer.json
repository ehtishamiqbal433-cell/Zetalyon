{
  "name": "ZETALYON OS - Zero-Trust Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "liveServer.settings.donotShowInfoMsg": true,
        "liveServer.settings.port": 5500
      },
      "extensions": [
        "ritwickdey.LiveServer",
        "tailwindCSS.vscode-tailwindcss",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [5500],
  "portsAttributes": {
    "5500": {
      "label": "ZETALYON Web Dashboard",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y git-lfs && git lfs install && npm install -g live-server"
}
